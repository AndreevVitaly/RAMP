DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
POSTGRES_DB=ramp
POSTGRES_USER=ramp
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
RAMP_ADMIN_KEY=replace-with-a-long-random-secret

# Email delivery
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=RAMP <no-reply@example.com>

# SMS provider: endpoint accepting {"phone": "...", "message": "..."}
SMS_PROVIDER_URL=
SMS_API_KEY=

# Telegram bot delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# MAX delivery endpoint
MAX_API_URL=
MAX_API_TOKEN=

